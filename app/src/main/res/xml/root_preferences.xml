<?xml version="1.0" encoding="utf-8"?>
<!-- All Soteria settings. Keys must match the constants in SettingsKeys. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_category_monitoring">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="monitor_calls"
            app:title="@string/pref_monitor_calls_title" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="monitor_sms"
            app:title="@string/pref_monitor_sms_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="monitor_email"
            app:title="@string/pref_monitor_email_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="monitor_whatsapp"
            app:title="@string/pref_monitor_whatsapp_title" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="auto_start_unknown"
            app:summary="@string/pref_auto_start_unknown_summary"
            app:title="@string/pref_auto_start_unknown_title" />

        <EditTextPreference
            app:key="trustline_number"
            app:title="@string/pref_trustline_number_title"
            app:defaultValue="+16043736537"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            app:key="backend_url"
            app:title="@string/pref_backend_url_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_session">

        <ListPreference
            app:defaultValue="30"
            app:entries="@array/session_length_entries"
            app:entryValues="@array/session_length_values"
            app:key="default_session_length"
            app:title="@string/pref_session_length_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="show_overlay"
            app:summary="@string/pref_show_overlay_summary"
            app:title="@string/pref_show_overlay_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_alerts">

        <ListPreference
            app:defaultValue="medium"
            app:entries="@array/sensitivity_entries"
            app:entryValues="@array/sensitivity_values"
            app:key="sensitivity"
            app:title="@string/pref_sensitivity_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="vibrate_on_alert"
            app:title="@string/pref_vibrate_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="sound_on_alert"
            app:title="@string/pref_sound_title" />

    </PreferenceCategory>

    <!-- Contact rows are added in code by SettingsFragment. -->
    <PreferenceCategory
        app:key="trusted_contacts_category"
        app:title="@string/pref_category_trusted_contacts">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="notify_contacts"
            app:title="@string/pref_notify_contacts_title" />

        <Preference
            app:key="add_contact"
            app:title="@string/pref_add_contact_title" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_privacy">

        <ListPreference
            app:defaultValue="1"
            app:entries="@array/auto_delete_entries"
            app:entryValues="@array/auto_delete_values"
            app:key="auto_delete"
            app:title="@string/pref_auto_delete_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="on_device"
            app:entries="@array/ai_mode_entries"
            app:entryValues="@array/ai_mode_values"
            app:key="ai_mode"
            app:title="@string/pref_ai_mode_title"
            app:useSimpleSummaryProvider="true" />

        <!-- Summaries (Granted / Not granted) are set in SettingsFragment.onResume(). -->
        <Preference
            app:key="perm_overlay"
            app:title="@string/pref_perm_overlay_title" />

        <Preference
            app:key="perm_mic"
            app:title="@string/pref_perm_mic_title" />

        <Preference
            app:key="perm_notifications"
            app:title="@string/pref_perm_notifications_title" />

    </PreferenceCategory>

</PreferenceScreen>
