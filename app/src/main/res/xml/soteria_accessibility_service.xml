<?xml version="1.0" encoding="utf-8"?>
<!-- Soteria doesn't read the screen. The service only exists so Android lets the app use the
     microphone during a call (offline transcription). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_service_description"
    android:notificationTimeout="1000"
    android:settingsActivity="com.example.soteria.SettingsActivity" />
