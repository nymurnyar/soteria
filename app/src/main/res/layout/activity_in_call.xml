<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inCallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_in_call"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".InCallActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Protection status -->
        <LinearLayout
            android:id="@+id/protectionPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/protectionIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_check" />

            <TextView
                android:id="@+id/protectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:accessibilityLiveRegion="polite"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Protected · Transcribing" />
        </LinearLayout>

        <!-- Caller -->
        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#33FFFFFF">

            <TextView
                android:id="@+id/avatarText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="A" />
        </FrameLayout>

        <TextView
            android:id="@+id/callerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="Alex Morgan" />

        <TextView
            android:id="@+id/callerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CBD5E1"
            android:textSize="15sp"
            tools:text="+1 780 555 0142" />

        <TextView
            android:id="@+id/callState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#A8D5A0"
            android:textSize="15sp"
            tools:text="02:13" />

        <!-- Scam warning (AI risk from the backend) -->
        <TextView
            android:id="@+id/riskBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:accessibilityLiveRegion="assertive"
            android:background="#DC2626"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Live transcript -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/transcriptCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:visibility="gone"
            app:cardBackgroundColor="#1AFFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_live_transcript"
                    android:textColor="#A8D5A0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/transcriptScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/transcriptText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/call_transcript_waiting"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#94A3B8"
                        android:textIsSelectable="true"
                        android:textSize="15sp" />
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:id="@+id/transcriptSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- In-call controls -->
        <LinearLayout
            android:id="@+id/controlsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/muteButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/call_mute"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_mic_off"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/speakerButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="32dp"
                android:contentDescription="@string/call_speaker"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_volume_up"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="26dp" />
        </LinearLayout>

        <!-- Offline (on-phone) transcription: start / stop during the call -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/offlineButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/call_offline_start"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:visibility="gone"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_mic"
            app:iconTint="#FFFFFF"
            tools:visibility="visible" />

        <!-- Answer / decline / hang up -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/declineButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/call_decline"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="#DC2626"
                app:cornerRadius="38dp"
                app:icon="@drawable/ic_call_end"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp"
                app:iconTint="#FFFFFF" />

            <Space
                android:id="@+id/answerSpacer"
                android:layout_width="88dp"
                android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answerButton"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/call_answer"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:backgroundTint="#16A34A"
                app:cornerRadius="38dp"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
