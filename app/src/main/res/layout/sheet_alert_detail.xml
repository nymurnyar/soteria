<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheetSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="HIGH RISK" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/sheetTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#5E6E84"
                android:textSize="12sp"
                tools:text="Yesterday · 4:18 PM" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheetCaller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#0B2C5E"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Unknown Caller" />

        <TextView
            android:id="@+id/sheetNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#5E6E84"
            android:textSize="14sp"
            tools:text="Private number" />

        <!-- Key facts -->
        <LinearLayout
            android:id="@+id/sheetFacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_soft_box"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/alerts_why_title"
            android:textColor="#0B2C5E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetWhy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:textColor="#334155"
            android:textSize="14sp"
            tools:text="• Possible impersonation\n• Credential request" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/alerts_todo_title"
            android:textColor="#0B2C5E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetTodo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:textColor="#334155"
            android:textSize="14sp"
            tools:text="1. Don't share passwords or one-time codes." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/alerts_excerpt_title"
            android:textColor="#0B2C5E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sheetTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_soft_box"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:textColor="#334155"
            android:textIsSelectable="true"
            android:textSize="13sp"
            tools:text="Caller: I'm calling from your IT department." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetSecondary"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:textAllCaps="false"
                tools:text="False alarm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheetPrimary"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textAllCaps="false"
                tools:text="Mark reviewed" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
